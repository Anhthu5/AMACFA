# Public fixture credentials are for localhost demos. Use synthetic invoice data.
AMACFA_DEMO_MODE=true
AMACFA_ANALYST_TOKEN=amacfa-demo-analyst
AMACFA_REVIEWER_TOKEN=amacfa-demo-reviewer
AMACFA_STATE_DIR=.amacfa
AMACFA_MAX_UPLOAD_BYTES=1048576
AMACFA_MAX_ROWS=1000

# Offline defaults. The Docker Compose stack sets Chroma and Neo4j.
AMACFA_VECTOR_BACKEND=local
AMACFA_GRAPH_BACKEND=local
AMACFA_NEO4J_URI=bolt://127.0.0.1:7687
AMACFA_NEO4J_USER=neo4j
AMACFA_NEO4J_DATABASE=neo4j
# AMACFA_NEO4J_PASSWORD=
# NEO4J_DEMO_PASSWORD=amacfa-graph-demo-only

AMACFA_LLM_BACKEND=offline
AMACFA_LLM_TIMEOUT_SECONDS=15
# AMACFA_LLM_MODEL=gpt-4o
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
